# @section 08 灵感素材
tab new <app-domain>/inspiration
wait --selector "#app>*"
console --fail-on error
screenshot <verify-dir>/screenshots/cruise-08-inspiration.png
close

# @section 09 AI 模型
tab new <app-domain>/aiModels
wait --selector "#app>*"
console --fail-on error
screenshot <verify-dir>/screenshots/cruise-09-models.png
